# ============================================================
# 环境变量示例（复制为 .env.local 并按需填写）
# 迁移后：PostgreSQL + 腾讯云 COS + 自写认证（无 Supabase）
# ============================================================

# PostgreSQL 连接串（自建 Postgres 或腾讯云 CDB）
DATABASE_URL=postgresql://user:pass@localhost:5432/wvc
# 数据库需要 SSL 时设为 true（腾讯云 CDB 一般需要）
DATABASE_SSL=false

# 会话 JWT 签名密钥（务必更换为高强度随机值）
# 生成：openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_string

# 腾讯云 COS 密钥（访问管理 CAM 里创建）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
# COS bucket 名称（不含 -appid 后缀）与地域，如 ap-guangzhou
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou
# 图片对外公开访问的基础 URL（桶设为公开读，或用 CDN 域名）
# 例：https://your-bucket-1234567890.cos.ap-guangzhou.myqcloud.com
NEXT_PUBLIC_IMAGE_BASE_URL=https://your-bucket-1234567890.cos.ap-guangzhou.myqcloud.com
